{
  "name": "civix-backend",
  "version": "1.0.0",
  "description": "Geolocation-based civic issue reporting API (Express + PostgreSQL/PostGIS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "psql \"$DATABASE_URL\" -f schema.sql && psql \"$DATABASE_URL\" -f seed.sql",
    "create-admin": "node create-admin.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.12.0"
  }
}
